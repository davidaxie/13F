# SEC EDGAR requires a User-Agent header identifying you and your contact info.
# See https://www.sec.gov/os/accessing-edgar-data
# Format: "Your Name your.email@example.com"
EDGAR_USER_AGENT="David Xie mrdxdavidxie@gmail.com"

# Clerk — auth. Without these, the app runs in "keyless" dev mode (temporary
# instance + setup widget). Get keys from https://dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email alerts — the hourly cron (vercel.json → /api/alerts/send) polls EDGAR
# for new 13F filings and emails subscribers. All of the following are needed
# for alerts to actually send in production:
#   • RESEND_API_KEY     — https://resend.com → API keys. Without it the cron
#                          returns 503 and sends nothing.
#   • RESEND_FROM_EMAIL  — verified sender (defaults to alerts@13f.mapperlab.co).
#   • CRON_SECRET        — authorizes the cron (Vercel sends it as a Bearer
#                          token) AND signs one-click unsubscribe links. In
#                          production the endpoint FAILS CLOSED if this is unset.
#   • NEXT_PUBLIC_SITE_URL — base URL for links in the email (default below).
# Subscriptions live in Vercel KV (KV_REST_API_URL / KV_REST_API_TOKEN are
# injected automatically by the Vercel KV integration — no need to set locally).
# NOTE: the hourly schedule (0 * * * *) requires a Vercel Pro plan; Hobby caps
# cron at once per day.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://13f.mapperlab.co

# Sentry — optional; if unset, the SDK initializes but doesn't report.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source-map upload (CI/Vercel only):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
